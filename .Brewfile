# Brewfile
# Generated for seonghwk's Mac
# Usage: brew bundle --file=~/.Brewfile

tap "homebrew/cask-fonts"

# CLI Tools
brew "bat"
brew "eza"
brew "fd"
brew "fzf"
brew "git"
brew "neovim"
brew "ripgrep"
brew "starship"
brew "tldr"
brew "tmux"
brew "tree-sitter"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# GUI Apps
cask "aldente"
cask "alfred"
cask "appcleaner"
cask "chatgpt"
cask "claude"
cask "docker-desktop"
cask "ghostty"
cask "google-chrome"
cask "google-gemini"
cask "karabiner-elements"
cask "keka"
cask "obsidian"
cask "spotify"
cask "visual-studio-code"

# Fonts
cask "font-d2coding-nerd-font"
cask "font-sauce-code-pro-nerd-font"
cask "font-jetbrains-mono-nerd-font"
